{
  "name": "saucedemo-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "E2E tests for saucedemo.com with Playwright + TypeScript (Page Object Model)",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:known-bugs": "playwright test --grep @known-bug",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0"
  }
}
